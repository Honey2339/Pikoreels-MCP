{
  "name": "@pikoreels/mcp",
  "version": "0.1.0",
  "description": "MCP server for PikoReels — lets Claude, Codex and other MCP clients drive your workspace.",
  "license": "MIT",
  "author": "PikoReels",
  "homepage": "https://app.pikoreels.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhexists/pikoreels-mcp.git"
  },
  "bugs": "https://github.com/shubhexists/pikoreels-mcp/issues",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "model-context-protocol",
    "claude",
    "pikoreels",
    "social-media",
    "scheduling",
    "ugc"
  ],
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "piko-mcp": "./dist/index.js" },
  "files": ["dist", "src", "README.md", "LICENSE"],
